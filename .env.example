# Hedera testnet operator used only by server-side routes/scripts.
# Never expose this value to the browser and never commit .env.local.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=0x_or_der_key_here

# Existing HCS topic for proof messages.
# HEDERA_HCS_TOPIC_ID is also accepted for legacy projects.
HEDERA_TOPIC_ID=0.0.xxxxx

# Optional override. Defaults to Hedera testnet mirror node.
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
