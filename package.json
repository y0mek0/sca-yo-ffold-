{
  "name": "hedera-agent-proof-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Scaffold-HBAR template for verifiable AI, research, and document workflows on Hedera HCS.",
  "license": "MIT",
  "workspaces": [
    "packages/nextjs"
  ],
  "scripts": {
    "dev": "npm run dev -w packages/nextjs",
    "build": "npm run build -w packages/nextjs",
    "lint": "npm run lint -w packages/nextjs",
    "typecheck": "npm run typecheck -w packages/nextjs",
    "test": "npm run test -w packages/nextjs",
    "doctor": "npm run doctor -w packages/nextjs",
    "audit:sample": "npm run audit:sample -w packages/nextjs",
    "verify:sample": "npm run verify:sample -w packages/nextjs",
    "hcs:submit": "npm run hcs:submit -w packages/nextjs",
    "mirror:verify": "npm run mirror:verify -w packages/nextjs --",
    "watch:github-release": "npm run watch:github-release -w packages/nextjs --",
    "watch:hbar-price": "npm run watch:hbar-price -w packages/nextjs --",
    "watch:github-issues": "npm run watch:github-issues -w packages/nextjs --",
    "payment:intent:hbar": "npm run payment:intent:hbar -w packages/nextjs --",
    "add:adapter": "npm run add:adapter -w packages/nextjs --"
  },
  "engines": {
    "node": ">=20.18.3"
  },
  "overrides": {
    "eslint": "9.39.5",
    "typescript-eslint": {
      "@typescript-eslint/parser": "^8.46.0",
      "@typescript-eslint/eslint-plugin": "^8.46.0"
    }
  }
}
